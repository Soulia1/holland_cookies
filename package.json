{
  "name": "holland-cookies",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:storefront && npm run build:dashboard",
    "build:deploy": "npm run build && npm prune --omit=dev",
    "start": "node backend/server.js",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard-src/tsconfig.json",
    "test:e2e": "playwright test",
    "test:webkit": "playwright test --config playwright.webkit.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node backend/server.js",
    "seed": "node backend/seed.js",
    "test:backend": "node --test backend/test/*.test.js",
    "test:all": "vitest run && node --test backend/test/*.test.js",
    "build:storefront": "vite build",
    "build:dashboard": "vite build --config dashboard-src/vite.config.ts",
    "dev:dashboard": "vite --config dashboard-src/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^12.42.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}
