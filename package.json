{
  "name": "holland-cookies",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:storefront && npm run build:dashboard",
    "build:deploy": "npm run build && npm prune --omit=dev",
    "start": "node backend/server.js",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard-src/tsconfig.json",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:webkit": "playwright test --project=storefront-webkit-phone --project=storefront-webkit-desktop --project=commerce-webkit-phone --project=commerce-webkit-desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node backend/server.js",
    "seed": "firebase emulators:exec --only firestore --project holland-cookie-test \"node backend/seed.js\"",
    "test:backend": "node --test backend/test/*.test.js",
    "test:all": "vitest run && npm run test:emulated",
    "build:storefront": "vite build",
    "build:dashboard": "vite build --config dashboard-src/vite.config.ts",
    "dev:dashboard": "vite --config dashboard-src/vite.config.ts",
    "emulators": "firebase emulators:start --only firestore --project holland-cookie-test",
    "emulators:exec": "firebase emulators:exec --only firestore --project holland-cookie-test",
    "test:security": "node --test tests/security/*.test.js",
    "test:emulated": "firebase emulators:exec --only firestore --project holland-cookie-test \"npm run test:backend && npm run test:security\"",
    "seed:prod": "node backend/seed.js",
    "test:chromium": "playwright test --project=storefront-chromium-desktop --project=storefront-chromium-phone --project=commerce-chromium-desktop --project=commerce-chromium-phone",
    "mail:check": "node scripts/mail-check.mjs",
    "dev:vite": "vite",
    "verify": "node scripts/verify-dev.mjs",
    "firebase:deploy": "node scripts/deploy-firestore-config.mjs",
    "check:indexes": "node scripts/check-indexes.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "framer-motion": "^12.42.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "uuid": "^11.1.0",
    "qs": "^6.15.4"
  }
}
