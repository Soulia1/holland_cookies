# Holland Cookie — environment
#
# Copy to `.env` for local development. `.env` is gitignored and must never be
# committed. No real secret belongs in this file.
#
# Every variable the code reads is listed here, including the ones you should
# NOT set. Before the pre-launch pass this file documented 5 of 21, which meant
# the only way to discover the rest was to grep the source or to have production
# refuse to boot.
#
# In production, `backend/config.js` validates all of this before the server
# listens. A misconfigured production deploy fails to start rather than starting
# and being subtly wrong.

# ─── Required in production ──────────────────────────────────────────────────

# The admin master key. 32–200 characters. Must not contain "change-me",
# "example", "e2e-", "benchmark" or "test-secret" — the validator rejects those.
ADMIN_KEY=

# Signs session tokens and rate-limit keys. Same length rules.
# MUST be different from ADMIN_KEY; the validator refuses to boot if they match.
# Rotating this invalidates every admin and customer session immediately.
JWT_SECRET=

# The canonical public origin, e.g. https://hollandcookie.com
# Must be https, and an origin only — no path, no trailing slash.
# Used by the CSRF origin guard.
APP_ORIGIN=

# ─── Firestore (required in production) ──────────────────────────────────────
#
# A Google Cloud service account with Firestore access. These replaced the
# SQLite DATABASE_PATH / DATA_VOLUME_PATH pair in the Firestore migration.

# PREFERRED — the entire serviceAccount.json pasted into one variable, exactly
# as Scooby does it on Railway. Use this one. The private key is a PEM block
# full of newlines, and a newline does not survive an environment variable;
# inside a JSON string the escaping is JSON's problem and JSON.parse undoes it,
# which is one fewer place for it to go wrong.
FIREBASE_SERVICE_ACCOUNT_JSON=

# For local work against a REAL project you can instead drop the key file at
# backend/serviceAccount.json — gitignored. Not for production.

# Legacy alternative: the same credential split across three variables. Still
# supported. The private key must then be quoted with its newlines written as
# the two characters backslash-n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Firestore (development and test ONLY) ───────────────────────────────────
#
# Point at the local emulator. `backend/firestore.js` REFUSES to connect a
# non-production process to a real Firestore project, so outside production one
# of these is required — there is deliberately no silent fallback to live data.
#
# The production validator refuses to boot if FIRESTORE_EMULATOR_HOST is set.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCLOUD_PROJECT=holland-cookie-test

# ─── Mail (required in production) ───────────────────────────────────────────
#
# Brevo, for customer sign-in codes only. No order depends on mail succeeding —
# a dead provider must never block a committed order.

BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Holland Cookie
MAIL_REPLY_TO=

# 'brevo' in production. 'console' prints codes to stdout (the e2e suite reads
# them from the log). 'disabled' turns mail off entirely.
MAIL_TRANSPORT=console

# Deliberately absent: BREVO_BASE_URL. The mail client's base URL is pinned in
# code so a stray environment variable cannot redirect outbound mail. The
# production validator rejects the environment if it is set.

# ─── Deployment ──────────────────────────────────────────────────────────────

PORT=3000
HOST=0.0.0.0

# Must be exactly 'single-instance' in production. The public rate limiter uses
# in-process counters; the strict classes (login, checkout, promo, OTP) are
# Firestore-backed and would survive multiple instances, but the declaration is
# required so the choice is explicit rather than assumed.
DEPLOYMENT_MODE=single-instance

# Comma-separated CIDRs of trusted reverse proxies. CIDRs, never a hop count —
# a hop count lets a directly-connected client spoof its IP and walk around
# every per-IP rate limit. Leave empty if nothing is in front of the server.
TRUSTED_PROXY_CIDRS=

# Surfaced in the startup log so a running instance can be tied to a commit.
RELEASE_SHA=

# ─── Development only ────────────────────────────────────────────────────────

# 'development' | 'test' | 'production'
NODE_ENV=development

# Extra CORS origins, comma separated. IGNORED in production, where the allow
# list is empty and the API is same-origin only.
ALLOWED_ORIGINS=http://127.0.0.1:5173

# Where `vite preview` proxies /api. The e2e suite points this at its own server
# on 3100; leave it unset for ordinary local work.
# HOLLAND_API_TARGET=http://127.0.0.1:3000

# ─── Must never be enabled ───────────────────────────────────────────────────

# Kept only so the production validator can explicitly reject it. Anything other
# than 'false' or empty refuses to boot. There is no code path that reads this
# to skip an auth check — the variable exists to be refused.
DISABLE_ADMIN_AUTH=false
