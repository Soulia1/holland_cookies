# Holland Cookies — environment.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the record of
# what the server actually reads, because a repo whose server refuses to boot
# with no way to find out why is not much use to the next person.

# ── Required ────────────────────────────────────────────────────────────────

# The dashboard's master key. Posted once and exchanged for an httpOnly session
# cookie; the dashboard never stores it. Without this, nothing can sign in.
ADMIN_KEY=change-me-to-something-long-and-random

# Signs admin and customer sessions. Rotating it invalidates every live session.
# Falls back to ADMIN_KEY when unset, which is fine locally and not in
# production — the two should be separate secrets.
JWT_SECRET=change-me-too

# ── Serving ─────────────────────────────────────────────────────────────────

PORT=3000

# Whether browsers reach this server over HTTPS. Deliberately its own variable
# rather than being inferred from NODE_ENV, because "is production" and "is
# served over TLS" are different facts. Two settings depend on it — the CSP's
# `upgrade-insecure-requests` and the session cookie's Secure flag — and both
# are actively harmful on a plain-HTTP origin: the first rewrites every asset
# URL to https:// so the page loads with no CSS or JavaScript, and the second
# means the browser never sends the session back.
#
# Set to true behind TLS. Leave false for local http.
HTTPS_ORIGIN=false

# Only needed when the front end runs on the Vite dev server against this
# backend. In production both are served from one origin and this matches
# nothing.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Where the SQLite file lives. Point this at a mounted volume in a container.
# Defaults to ./data/holland.db
# DATABASE_PATH=/data/holland.db

# ── Mail (optional — sign-in codes) ─────────────────────────────────────────
#
# Customer accounts sign in with a one-time code emailed to the address. With
# no provider configured the code is printed to the server log instead, which
# works for development; in production the request is refused outright rather
# than resolving as if something had been sent.

# BREVO_API_KEY=
# MAIL_FROM_NAME=Holland Cookies
# MAIL_FROM_EMAIL=orders@hollandcookies.example
# MAIL_REPLY_TO=

# Forces the log transport even under NODE_ENV=production. Used by the
# end-to-end suite, which runs a production-configured server and genuinely
# needs it. Never set this on a real deployment.
# MAIL_TRANSPORT=console

# ── Note ────────────────────────────────────────────────────────────────────
#
# Do NOT put NODE_ENV in .env. Vite reads the same file, and NODE_ENV=development
# there puts the *production build* into development mode — which swaps in
# React's development bundle and adds ~180KB to the chunk the boot splash waits
# on. Set it in the process environment instead.
